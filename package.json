{
  "name": "orabella-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Orabella MVP rebuild — Next.js 15 + React 19 + Supabase (T1 scaffold)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:concurrency": "node tests/concurrency/preflight.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/concurrency/run.ts",
    "test:postgres-closure": "vitest run --config vitest.postgres-closure.config.ts",
    "verify:backup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-backup-restore.ts",
    "plan:portable-migrations": "node scripts/plan-portable-migrations.mjs",
    "verify:portable-migrations": "node scripts/verify-portable-migration-plan.mjs",
    "apply:portable-migrations": "node scripts/apply-portable-migration-plan.mjs",
    "test:portable-migrations": "node tests/portable-migration-cli.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:changed": "playwright test --grep @changed",
    "test:e2e:full": "playwright test --grep @full"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.47.0",
    "next": "15.5.25",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "5.0.1"
  }
}
